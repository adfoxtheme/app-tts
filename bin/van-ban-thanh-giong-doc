#!/usr/bin/env bash
# Launcher for "Văn bản thành giọng đọc" (Text to Speech)
set -e

APP_DIR="$HOME/.local/share/van-ban-thanh-giong-doc"
PYTHON_BIN="$APP_DIR/venv/bin/python3"
MAIN_SCRIPT="$APP_DIR/app/main.py"

if [ ! -f "$PYTHON_BIN" ]; then
    echo "Lỗi: Không tìm thấy môi trường Python ảo tại $PYTHON_BIN" >&2
    exit 1
fi

export PYTHONPATH="$APP_DIR/engine:$APP_DIR/app:$PYTHONPATH"
exec "$PYTHON_BIN" "$MAIN_SCRIPT" "$@"
